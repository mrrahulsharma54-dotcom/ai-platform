# Boxput AI Website Builder - Environment Variables
# Hostinger Node.js & Local Deployment Configuration

# GEMINI_API_KEY: Required for server-side Gemini AI website generation and AI edits
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Supabase Public Anon Key
SUPABASE_ANON_KEY="your-anon-key"

# Port (defaults to 3000)
PORT=3000

# APP_URL: Base URL of your deployed application
APP_URL="http://localhost:3000"
